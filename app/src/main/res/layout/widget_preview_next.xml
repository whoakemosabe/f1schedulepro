<?xml version="1.0" encoding="utf-8"?>
<!-- What the "Next session" widget looks like, shown in the launcher's widget picker. Static
     sample content; the real widget is drawn by Glance (NextContent in Widgets.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:clipToOutline="true"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#FFFF4A44" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXT SESSION"
            android:textColor="#FF8A93BD"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:text="🇧🇷 São Paulo Grand Prix"
            android:textColor="#FFF0F2FF"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUALIFYING"
            android:textColor="#FF00D4FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:text="1d 4h"
            android:textColor="#FF00D4FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Sat 18:00 GMT"
            android:textColor="#FFA0A8C8"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
